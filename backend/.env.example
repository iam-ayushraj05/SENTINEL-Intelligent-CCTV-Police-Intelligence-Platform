# ============================================================
# SENTINEL CCTV Platform — Backend Environment Configuration
# ============================================================
# Copy to backend/.env and fill in authorized values.
# NEVER commit backend/.env to version control.
# ============================================================

# --- Core ---
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# --- CCTV Resource Platform (Authorized Access Only) ---
# The operator must enter valid credentials manually.
# These values are NEVER exposed to the browser or logged.
SENTINEL_CCTV_EMAIL=
SENTINEL_CCTV_PASSWORD=
SENTINEL_CCTV_HOST=103.250.160.189
SENTINEL_CCTV_RTSP_PORT=8554
SENTINEL_CCTV_WHEP_PORT=8889
SENTINEL_CCTV_HLS_BASE=https://cctv.corp8.cloud
SENTINEL_CCTV_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
SENTINEL_CCTV_MODE=live

# --- Resource Limits ---
MAX_CONCURRENT_VIEWERS=10
MAX_AI_CAMERAS=4
AI_FRAME_INTERVAL_MS=500

# --- AI Pipeline ---
AI_MODEL=yolov8n
AI_CONFIDENCE_THRESHOLD=0.50
AI_ANPR_CONFIDENCE_THRESHOLD=0.65
AI_MODEL_PATH=yolo11n.pt
AI_EVENT_CONFIRMATION_FRAMES=3
AI_EVENT_COOLDOWN_SECONDS=30

# --- Evidence ---
EVIDENCE_PRE_EVENT_SECONDS=10
EVIDENCE_POST_EVENT_SECONDS=20
EVIDENCE_STORAGE_PATH=./evidence

# --- Demo Mode ---
DEMO_MODE=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/alerts
