# Backend
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/alerts
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# CCTV Resource Platform (AUTHORIZED CREDENTIALS)
SENTINEL_CCTV_EMAIL=
SENTINEL_CCTV_PASSWORD=
SENTINEL_CCTV_HOST=103.250.160.189
SENTINEL_CCTV_RTSP_PORT=8554
SENTINEL_CCTV_WHEP_PORT=8889
SENTINEL_CCTV_HLS_BASE=https://cctv.corp8.cloud
SENTINEL_CCTV_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
SENTINEL_CCTV_MODE=live

# AI stream catalogue (prefer catalogue-driven RTSP sources)
AI_CATALOGUE_URL=http://localhost:8000/api/v1/cameras/ingest

# Streaming
MEDIAMTX_API_URL=http://localhost:9997

# AI
AI_MODEL=placeholder
AI_CONFIDENCE_THRESHOLD=0.50
AI_MODEL_PATH=yolo11n.pt
AI_EVENT_CONFIRMATION_FRAMES=3
AI_EVENT_COOLDOWN_SECONDS=30
HIGH_ALERT_RETRY_INTERVAL=300
HIGH_ALERT_MAX_RETRIES=5
EVIDENCE_PRE_EVENT_SECONDS=10
EVIDENCE_POST_EVENT_SECONDS=20
EVIDENCE_STORAGE_PATH=./evidence

# Emergency & Alert Services
ENABLE_SMS_ALERTS=true
ENABLE_VOICE_CALLS=true
ENABLE_TTS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Hospital & Emergency Services
DEFAULT_HOSPITAL_API_URL=https://api.hospital-service.local/hospitals
POLICE_EMERGENCY_PHONE=+91-emergency-phone

# Multi-camera Correlation
EVENT_CORRELATION_TIMEOUT_SECONDS=30
CAMERA_PROXIMITY_DISTANCE_METERS=500

# Demo Mode
DEMO_MODE=false
